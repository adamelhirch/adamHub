{
  "manifest_version": 3,
  "name": "AdamHUB Connect",
  "short_name": "AdamHUB",
  "version": "0.3.0",
  "description": "Synchronise tes sessions Carrefour, Intermarché, Leclerc et Auchan avec ton hub AdamHUB.",
  "action": {
    "default_title": "AdamHUB Connect",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "cookies",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5174/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.carrefour.fr/*",
    "*://*.intermarche.com/*",
    "*://*.leclercdrive.fr/*",
    "*://*.auchan.fr/*"
  ],
  "icons": {
    "128": "icon128.png"
  }
}
