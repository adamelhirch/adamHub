# Runtime environment: development | test | production.
# Dev/test contexts may use insecure dev defaults (change-me API key, derived
# JWT/cookie keys, allow_origins="*"). Anything else MUST be securely configured.
ADAMHUB_ENV=development
ADAMHUB_API_KEYS=key1,key2
ADAMHUB_API_KEY=key1
# Legacy single-user path: API-key-only requests resolve to this user.
ADAMHUB_OWNER_EMAIL=you@example.com
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_API_KEY=key1
ADAMHUB_DB_URL=postgresql+psycopg://adamhub:adamhub@localhost:5432/adamhub
ADAMHUB_PUBLIC_BASE_URL="https://hub.adamelhirch.com"
ADAMHUB_ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://hub.adamelhirch.com"
ADAMHUB_INTERMARCHE_PROXY_URL=
ADAMHUB_UBEREATS_PROXY_URL=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development (a dev-only key is derived); required in production.
ADAMHUB_COOKIE_ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave empty in development (a dev-only key is derived); required in production.
ADAMHUB_JWT_SECRET=
POSTGRES_DB=adamhub
POSTGRES_USER=adamhub
POSTGRES_PASSWORD=adamhub

# Notifications (NTFY)
# Créez votre propre sujet sur l'application NTFY (ex: adamhub_secret_1234)
ADAMHUB_NTFY_TOPIC=
ADAMHUB_NTFY_SERVER=https://ntfy.sh
ADAMHUB_MIGRATION_RETRIES=30
ADAMHUB_MIGRATION_DELAY=2

# Email verification (Resend). Leave ADAMHUB_RESEND_API_KEY empty in dev/test
# (verification is skipped); required for production email sending.
# Create an API key at https://resend.com/api-keys and verify a sending domain.
ADAMHUB_RESEND_API_KEY=
ADAMHUB_EMAIL_FROM="AdamHUB <onboarding@resend.dev>"
