# Runtime environment: development | test | production.
# VPS/production MUST be production and MUST provide real secrets below —
# startup refuses to run otherwise.
ADAMHUB_ENV=production
ADAMHUB_API_KEYS=change-me-to-a-long-random-secret
# Convenience mirror for tooling/docs. The backend reads ADAMHUB_API_KEYS.
ADAMHUB_API_KEY=change-me-to-a-long-random-secret
# Legacy single-user path: API-key-only requests resolve to this user.
ADAMHUB_OWNER_EMAIL=you@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ADAMHUB_JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADAMHUB_COOKIE_ENCRYPTION_KEY=
ADAMHUB_PUBLIC_BASE_URL=https://adamhub.example.com
ADAMHUB_ALLOW_ORIGINS=https://adamhub.example.com
VITE_API_URL=https://adamhub.example.com/api/v1
VITE_API_KEY=change-me-to-a-long-random-secret
ADAMHUB_NTFY_TOPIC=
ADAMHUB_NTFY_SERVER=https://ntfy.sh
ADAMHUB_UBEREATS_PROXY_URL=
ADAMHUB_MIGRATION_RETRIES=30
ADAMHUB_MIGRATION_DELAY=2

POSTGRES_DB=adamhub
POSTGRES_USER=adamhub
POSTGRES_PASSWORD=change-me-db-password

ADAMHUB_PORT=8000
